PORT=3000

# OANDA Live Data (Required)
# Get a free demo account at https://developer.oanda.com/
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_URL=https://stream-fxpractice.oanda.com

# Pairs to track
FOREX_PAIRS=EUR_USD,GBP_USD,USD_JPY,AUD_USD

# Database (Required)
# Get a free tier Postgres at https://supabase.com/ or https://neon.tech/
DATABASE_URL=postgres://user:password@host:5432/dbname

# Telegram Alerts (Optional but recommended)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LLM Narrative Layer (Optional, defaults to Gemini free tier)
# Get a free Gemini key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Fallbacks/Upgrades (Commented out by default)
# OLLAMA_HOST=http://localhost:11434
# LLM_PROVIDER=claude
# LLM_API_KEY=your_paid_api_key_here
# RESEND_API_KEY=your_resend_api_key_here
